{
  "type": "object",
  "title": "Row configuration",
  "properties": {
    "source": {
      "type": "object",
      "title": "Source",
      "required": true,
      "propertyOrder": 1,
      "properties": {
        "object": {
          "type": "string",
          "title": "Object to extract",
          "required": true,
          "enum": [
            "customers",
            "suppliers",
            "invoices_issued",
            "invoices_received",
            "advance_invoices_issued",
            "advance_invoices_received",
            "orders_received",
            "orders_issued",
            "products",
            "stock_receipts",
            "stock_issues",
            "stock_levels",
            "warehouses",
            "vat_rates",
            "cost_centers",
            "jobs",
            "document_series"
          ],
          "enum_titles": [
            "Customers",
            "Suppliers",
            "Issued Invoices",
            "Received Invoices",
            "Issued Advance Invoices",
            "Received Advance Invoices",
            "Received Orders",
            "Issued Orders",
            "Products",
            "Stock Receipts",
            "Stock Issues",
            "Stock Levels",
            "Warehouses",
            "VAT Rates",
            "Cost Centers",
            "Jobs",
            "Document Series"
          ],
          "propertyOrder": 1
        },
        "date_from": {
          "type": "string",
          "title": "Date from",
          "description": "Optional lower bound for a backfill (yyyy-MM-dd). Maps to PREMIER dat_od parameter.",
          "format": "date",
          "propertyOrder": 2,
          "options": {
            "dependencies": {
              "object": ["invoices_issued", "invoices_received", "advance_invoices_issued", "advance_invoices_received", "orders_received", "orders_issued"]
            }
          }
        },
        "date_to": {
          "type": "string",
          "title": "Date to",
          "description": "Optional upper bound for a backfill (yyyy-MM-dd). Maps to PREMIER dat_do parameter.",
          "format": "date",
          "propertyOrder": 3,
          "options": {
            "dependencies": {
              "object": ["invoices_issued", "invoices_received", "advance_invoices_issued", "advance_invoices_received", "orders_received", "orders_issued"]
            }
          }
        },
        "warehouse": {
          "type": "integer",
          "title": "Warehouse number",
          "description": "REQUIRED when Object to extract is Products. Warehouse number to read stock cards from; leave blank for other objects.",
          "minimum": 1,
          "propertyOrder": 4,
          "options": {
            "dependencies": {
              "object": ["products", "stock_receipts", "stock_issues", "stock_levels"]
            }
          }
        }
      }
    },
    "destination": {
      "type": "object",
      "title": "Destination",
      "propertyOrder": 2,
      "properties": {
        "load_type": {
          "type": "string",
          "title": "Load type",
          "description": "Incremental load uses the API change timestamp stored in component state to fetch only new or modified records. Full load replaces the output table on every run.",
          "enum": [
            "incremental_load",
            "full_load"
          ],
          "enum_titles": [
            "Incremental Load",
            "Full Load"
          ],
          "default": "incremental_load",
          "propertyOrder": 1
        }
      }
    }
  }
}
